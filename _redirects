# Clean URL redirects — Cloudflare Pages
# Redirect /explore → the v2 map
/explore          /v2/explore.html    301
/map              /v2/explore.html    301
/network          /v2/explore.html    301

# Redirect /vision → about
/vision           /about.html         301

# Redirect old /v2 root to explore
/v2               /v2/explore.html    301
/v2/              /v2/explore.html    301

# Block access to internal docs and build scripts
/CHATBOT-SETUP.md       /404.html 404
/EMAIL-SETUP.md         /404.html 404
/SETUP-CHECKLIST.md     /404.html 404
/codex-tasks.md         /404.html 404
/link-audit.md          /404.html 404
/name-fixes.md          /404.html 404
/README.md              /404.html 404
/FRQNCY*                /404.html 404
/package.json           /404.html 404
/generate.js            /404.html 404
/generate-courses.js    /404.html 404
/generate-watch.js      /404.html 404
/build-kb.js            /404.html 404
/build-og.js            /404.html 404
/og-image.svg           /404.html 404
/workers/*              /404.html 404
/versions/*             /404.html 404

# Block Astro source project (built output lives at /social/ directly)
/social-src/*           /404.html 404
/social-app*            /404.html 404
/apps/*                 /404.html 404
/IDEAS.md               /404.html 404
/AUDIT-REPORT.md        /404.html 404
/docs/*                 /404.html 404

# Hide Astro static-build artifacts that are not referenced by any page
/social/*.mjs           /404.html 404
/social/pages/*         /404.html 404
/social/chunks/*        /404.html 404

# Dynamic profile route — serve the same shell for any username
/social/profile/*       /social/profile/index.html 200

# Legacy leaderboard URL → /social/space (cooperation-over-competition)
/social/leaderboard     /social/space              301
/social/leaderboard/    /social/space              301

# 404 fallback — Cloudflare Pages reads this automatically
/*                /404.html           404
