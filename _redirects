# /social/profile/<username> dynamic routing — now handled by the
# functions/social/profile/[[path]].js Pages Function. It defers to
# static for /keys/, /connections/, /bluesky-callback/, and the OAuth
# JSON, and rewrites to /social/profile/index.html for any other path
# (e.g. /social/profile/<username>). _redirects can't express this
# selectively — see the cf-pages-catchall-hijacks-static memory.

# Backup: /social/u/* still works as a clean dynamic-profile namespace
# (no static-file collision possible) for any new code that wants to
# route there directly.
/social/u/*             /social/profile/index.html 200

# Dynamic channel route — same shell for every channel slug. The Astro build
# emits /social/channel/<seed>/index.html for the seeds in getStaticPaths;
# this redirect routes any other slug to one of them so the Preact ChannelView
# can read the slug from location.pathname and filter the feed.
/social/channel/*       /social/channel/research/index.html 200

# Dynamic group route — same shell for every group slug. The Astro build emits
# /social/g/<seed>/index.html for the seeds in getStaticPaths; this routes any
# user-created slug to one of them so the Preact GroupView reads the slug from
# location.pathname and loads that group. Deliberately under /social/g/* (not
# /social/groups/*) so this 200-rewrite catchall can't hijack the static
# /social/groups directory page (see cf-pages-catchall-hijacks-static).
/social/g/*             /social/g/townhall/index.html 200

# Dynamic single-post route — same shell for every post id. The Astro build
# emits /social/post/shell/index.html; this redirect routes any post id to
# it so the Preact PostView can fetch the post by id from the URL.
/social/post/*          /social/post/shell/index.html 200

# Legacy leaderboard URL → /social/space (cooperation-over-competition)
/social/leaderboard     /social/space              301
/social/leaderboard/    /social/space              301

# 404 fallback — Cloudflare Pages reads this automatically
