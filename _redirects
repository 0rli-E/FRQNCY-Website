# Dynamic user-profile route — namespaced under /social/u/ so it cannot
# collide with the static settings sub-pages of /social/profile/ (keys,
# connections, bluesky-callback, bluesky-oauth-client.json). The previous
# /social/profile/* catchall hijacked those static files even when written
# as a 301 — confirmed empirically 2026-05-16 that CF Pages applies the
# catchall before any static-file resolution regardless of status code.
# By moving the dynamic route under a separate prefix the catchall and the
# static files can coexist cleanly.
/social/u/*             /social/profile/index.html 200

# NOTE: deliberately NO catchall on /social/profile/<username>. Inbound
# links to legacy /social/profile/<username> URLs (~2 users in production
# as of 2026-05-16) will 404. If/when that becomes load-bearing, add
# specific 301 lines per username — never a wildcard, or the static sub-
# pages re-break.

# Dynamic channel route — same shell for every channel slug. The Astro build
# emits /social/channel/<seed>/index.html for the seeds in getStaticPaths;
# this redirect routes any other slug to one of them so the Preact ChannelView
# can read the slug from location.pathname and filter the feed.
/social/channel/*       /social/channel/research/index.html 200

# Dynamic single-post route — same shell for every post id. The Astro build
# emits /social/post/shell/index.html; this redirect routes any post id to
# it so the Preact PostView can fetch the post by id from the URL.
/social/post/*          /social/post/shell/index.html 200

# Legacy leaderboard URL → /social/space (cooperation-over-competition)
/social/leaderboard     /social/space              301
/social/leaderboard/    /social/space              301

# 404 fallback — Cloudflare Pages reads this automatically
/*                /404.html           404

# Metaphysics renamed to Consciousness 2026-05-05
/v2/metaphysics/* /v2/consciousness/:splat 301

# /v2/ prefix removed 2026-05-12 — every old path 301s to its new home.
/v2/media/*          /broadcast/:splat        301
/v2/music/*          /music-topic/:splat      301
/v2/places/*         /places-domain/:splat    301
/v2/explore.html     /explore.html            301
/v2/explore-data.js  /explore-data.js         301
/v2/explore-data.json /explore-data.json      301
/v2/*                /:splat                  301
