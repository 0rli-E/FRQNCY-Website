# Clean URL redirects — Cloudflare Pages
# Canonical is the clean URL (`/explore`). The previous rule
# `/explore → /explore.html 301` fought CF Pages' default `.html` stripping
# (`/explore.html → 308 → /explore`) and produced an infinite redirect loop
# that broke the Explore tab inside the FRQNCY mobile app's iframe shell.
# Pick one canonical (clean) and redirect aliases TO it.
/explore.html     /explore            301
/map              /explore            301
/network          /explore            301

# Topic rename 2026-05-15: Manifestation → Conscious Creation (Voice Playbook)
/manifestation    /conscious-creation 301
/manifestation/*  /conscious-creation/:splat 301

# Privacy / data-deletion endpoint (required by Play Data Safety form)
/delete           /delete.html        301

# Canonical clean URLs — drop .html
/about.html       /about              301
/platform.html    /platform           301
/podcast.html     /podcast            301
/space.html       /space              301
/chart.html       /chart              301
/search.html      /search             301
# Unified discovery — Search + Ask now live inside /browse (the ?q= param prefills)
/search           /browse             301
/ask              /browse             301
/ask/             /browse             301
/my-frqncy.html   /my-frqncy          301
/start-here.html  /start-here         301

# Redirect /vision → about
/vision           /about              301

# Redirect old /v2 root to explore (post-refactor: /v2/ no longer exists)
/v2               /explore            301
/v2/              /explore            301

