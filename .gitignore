*.bak

# Agent / Cowork — local-only settings
.claude/

# Node
node_modules/
package-lock.json
npm-debug.log*
yarn-error.log*

# Secrets — never commit these
.env
.env.local
*.secret

# Cloudflare
.wrangler/

# Astro project source lives in /social-src/; built static output is committed
# at /social/ (that's what Cloudflare Pages serves at URL /social/*).
social-src/.astro/
social-src/dist/
social-src/node_modules/
social-src/.wrangler/
social-app.superseded/
*.old
*.old.*

# Auto-generated — committed by GitHub Actions, not manually
# (DO NOT add v2/ or functions/api/_kb.js here — CI commits them)

# Internal docs — should not be publicly deployed
# (use `git rm --cached <file>` to untrack without deleting)
FRQNCY-Reading-List.docx
*.secret

supabase/.temp/

# Playwright MCP temp artifacts (per-session logs + page snapshots)
.playwright-mcp/

# Ad-hoc screenshots taken during dev review (Playwright `filename: …png`).
# These accumulate at repo root from agent UX reviews and shouldn't ship.
/app-*.png
/alarm-*.png
/bedside-*.png
/settings-*.png
/sleep-*.png
/wake-*.png
/*-390x844.png
# Same class, different prefixes — surface/feature review shots.
/sanctuary-*.png
/vbrtn-*.png
/miro-*.png
/door-*.png
/legal-*.png
/merged-*.png

# Legal / tax / account material. THIS REPO IS PUBLIC — per CLAUDE.md these
# belong in the private tracker (0rli-E/frqncy-ops), never here. The tax scan
# carries a "Personal layer (Orlando + Norman)" section with personal
# residency planning; the legal plan names ownership splits. Pushing either is
# irreversible once GitHub has indexed it.
proposals/LEGAL-STRUCTURE-PLAN-*.md
proposals/GLOBAL-TAX-SCAN-*.md
proposals/WYOMING-VS-ESTONIA-DASHBOARD.html
proposals/FRQNCY-Social-Account-Registry.xlsx

