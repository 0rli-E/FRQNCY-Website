<!--
  Additions to Info.plist required by VbrtnAlarm (the wake/sleep feature) on iOS.
  Merge these into ios/App/App/Info.plist after `npx cap add ios`.
-->

<!-- Background modes: audio lets the alarm ring when locked. -->
<key>UIBackgroundModes</key>
<array>
    <string>audio</string>
    <string>fetch</string>
</array>

<!-- Required so AVPlayer can stream audio from Cloudflare R2/Stream -->
<key>NSAppTransportSecurity</key>
<dict>
    <key>NSAllowsArbitraryLoadsForMedia</key>
    <true/>
</dict>

