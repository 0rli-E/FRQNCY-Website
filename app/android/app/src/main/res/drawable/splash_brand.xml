<!--
  splash_brand — the centered ring+wave brand mark used in the launch splash.
  Sized for the Android 12+ Splash Screen API window; legacy splash.xml
  layers this on top of the dark background.

  Stays under the 192dp safe-zone of the modern splash icon API.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="160dp"
    android:height="160dp"
    android:viewportWidth="160"
    android:viewportHeight="160"
    android:tint="@color/frqncy_gold">

    <!-- Outer ring centered at (80, 80), radius 44 -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:fillColor="#00000000"
        android:pathData="M 80,80 m -44,0 a 44,44 0 1,0 88,0 a 44,44 0 1,0 -88,0" />

    <!-- Subtle outer halo, radius 50, dimmer -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="0.8"
        android:strokeAlpha="0.3"
        android:fillColor="#00000000"
        android:pathData="M 80,80 m -50,0 a 50,50 0 1,0 100,0 a 50,50 0 1,0 -100,0" />

    <!-- Sound wave bisecting the ring -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.2"
        android:fillColor="#00000000"
        android:pathData="M 48,80 Q 56,68 64,80 T 80,80 T 96,80 T 112,80" />

    <!-- Tuning dot above the wave -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M 80,60 m -2.4,0 a 2.4,2.4 0 1,0 4.8,0 a 2.4,2.4 0 1,0 -4.8,0" />
</vector>
