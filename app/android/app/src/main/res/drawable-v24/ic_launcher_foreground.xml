<!--
  VBRTN launcher icon foreground — a thin gold ring with a sound-wave bisecting
  it, on the brand navy background. Adaptive icon viewport is 108dp; the safe
  zone for content is roughly the inner 72dp square (18..90 in viewport coords)
  per Android adaptive icon guidance.

  Color: #C4973A — the VBRTN brand gold (matches colors.xml frqncy_gold token).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer ring centered at (54, 54), radius 28 -->
    <path
        android:strokeColor="#E8C547"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M 54,54 m -28,0 a 28,28 0 1,0 56,0 a 28,28 0 1,0 -56,0" />

    <!-- Subtle outer halo, radius 32 -->
    <path
        android:strokeColor="#E8C547"
        android:strokeWidth="0.5"
        android:strokeAlpha="0.35"
        android:fillColor="#00000000"
        android:pathData="M 54,54 m -32,0 a 32,32 0 1,0 64,0 a 32,32 0 1,0 -64,0" />

    <!-- Sound wave bisecting the ring at y=54 -->
    <path
        android:strokeColor="#E8C547"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M 32,54 Q 40,44 48,54 T 64,54 T 80,54" />

    <!-- Tuning dot — slightly above the wave at (54, 40) -->
    <path
        android:fillColor="#E8C547"
        android:pathData="M 54,40 m -1.6,0 a 1.6,1.6 0 1,0 3.2,0 a 1.6,1.6 0 1,0 -3.2,0" />
</vector>
