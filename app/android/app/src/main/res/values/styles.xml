<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!--
      Post-launch app theme. Edge-to-edge friendly: status + nav bars match
      the brand black so the system chrome reads as "part of the app" rather
      than as a stripe.
    -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/frqncy_dark</item>
        <item name="android:navigationBarColor">@color/frqncy_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>


    <!--
      Launch theme. Two layers:
        1. Legacy (`android:background`) — pre-Android-12 + the
           Capacitor splash plugin (configured in capacitor.config.ts via
           androidSplashResourceName: 'splash').
        2. Modern (`windowSplashScreenBackground` + `windowSplashScreenAnimatedIcon`)
           — Android 12+ uses the system splash screen API, which honors these
           attributes and shows the branded ring+wave on the dark background.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/frqncy_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_brand</item>
        <item name="windowSplashScreenAnimationDuration">300</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>

    <!-- FrqncyAlarm: full-screen alarm activity, edge-to-edge dark theme -->
    <style name="Theme.Frqncy.Alarm" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/frqncy_dark</item>
        <item name="android:colorBackground">@color/frqncy_dark</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowShowWallpaper">false</item>
    </style>
</resources>