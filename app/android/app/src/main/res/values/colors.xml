<?xml version="1.0" encoding="utf-8"?>
<!--
  FRQNCY brand palette. Used by AppTheme in styles.xml + various tinting
  hooks (notification icon, status bar, splash background).

  Values picked to match the web side at frqncy.network and the index.css
  tokens — gold accent (#E8C547), dark base (#0A0A0A), ivory text (#F5F5F5).
-->
<resources>
    <!-- AppTheme requirements -->
    <color name="colorPrimary">#0A0A0A</color>
    <color name="colorPrimaryDark">#000000</color>
    <color name="colorAccent">#E8C547</color>

    <!-- Brand semantic tokens, available everywhere -->
    <color name="frqncy_dark">#0A0A0A</color>
    <color name="frqncy_dark_alt">#141414</color>
    <color name="frqncy_gold">#E8C547</color>
    <color name="frqncy_ivory">#F5F5F5</color>
    <color name="frqncy_ivory_dim">#A0A0A0</color>
</resources>
