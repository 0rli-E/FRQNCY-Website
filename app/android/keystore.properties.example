# Copy to android/keystore.properties and fill in after generating the keystore.
# This file (the .example) is safe to commit. keystore.properties itself is gitignored.
#
# Generate the keystore once:
#   keytool -genkey -v -keystore vbrtn-release.jks -alias vbrtn -keyalg RSA -keysize 2048 -validity 10000
# Keep vbrtn-release.jks and these passwords backed up somewhere safe — losing
# them means you can never ship an update to the same app listing.

storeFile=../vbrtn-release.jks
storePassword=CHANGE_ME
keyAlias=vbrtn
keyPassword=CHANGE_ME
