---
import SocialLayout from '../../layouts/SocialLayout.astro';
import ProfileCard from '../../components/ProfileCard';
import ProfileStats from '../../components/ProfileStats';
import FollowButton from '../../components/FollowButton';
import StartConversationButton from '../../components/StartConversationButton';
import Feed from '../../components/Feed';

const { username } = Astro.params;
const safeUsername = username || '';
---

<SocialLayout title={`@${safeUsername}`}>
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 mt-6">

    <!-- Profile sidebar -->
    <aside class="lg:col-span-4 space-y-4">
      <ProfileCard client:load username={safeUsername} />

      <div class="rounded-xl bg-card-bg border border-card-border p-5">
        <FollowButton client:load username={safeUsername} />
        <StartConversationButton client:load username={safeUsername} />
      </div>

      <!-- Stats (live from profiles table) -->
      <ProfileStats client:load username={safeUsername} />
    </aside>

    <!-- Posts feed (filtered to this user) -->
    <section class="lg:col-span-8">
      <h2 class="font-heading text-2xl text-gold mb-4">Posts by @{safeUsername}</h2>
      <Feed client:load username={safeUsername} />
    </section>
  </div>
</SocialLayout>
