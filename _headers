/*
  # Security headers — applied to every response
  # X-Frame-Options dropped 2026-05-14 in favor of CSP frame-ancestors,
  # which supports per-origin allow-listing (XFO only supports DENY/SAMEORIGIN).
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  # frame-ancestors permits FRQNCY's own Capacitor mobile app to embed live site
  # content in its iframe shell: https://localhost (Android), capacitor://localhost
  # (iOS), http://localhost:5173 (vite dev preview). Risk is negligible — only
  # device-local origins, no public web origin can frame the site.
  #
  # This CSP must stay a SINGLE rule under /*. Cloudflare Pages JOINS values when
  # several _headers rules set the same header, and joined CSP values are enforced
  # as separate policies (their intersection). So a second, looser /social/* rule
  # would grant nothing — it would only add restrictions. Edit this line instead.
  #
  # 'wasm-unsafe-eval' (added 2026-08-02) lets libsodium-wrappers instantiate its
  # WebAssembly module. Without it NRG's entire E2EE layer — encrypted DMs, key
  # generation, signing, encrypted backup — throws on every page load. It permits
  # WebAssembly compilation ONLY; it does NOT permit eval() of JavaScript strings,
  # so it is a far narrower grant than 'unsafe-eval'.
  #
  # connect-src additions (2026-08-02) are the fixed set of hosts NRG's protocol
  # bridges call: bsky.social + api.bsky.app + *.host.bsky.network + plc.directory
  # (ATProto OAuth, DID resolution, cross-post), the three Nostr relays in
  # nostr-publish.ts, and api.ethos.network (read-only vouch lookups). All were
  # blocked before, which silently disabled every one of those shipped features.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://plausible.io https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://plausible.io https://*.workers.dev https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com https://bsky.social https://api.bsky.app https://*.host.bsky.network https://plc.directory https://api.ethos.network wss://relay.damus.io wss://nos.lol wss://relay.snort.social; frame-src https://www.youtube.com https://player.vimeo.com https://www.gaia.com; frame-ancestors 'self' https://localhost capacitor://localhost http://localhost:5173

# Favicon + manifest — cache forever (immutable per deploy)
/favicon.svg
  Cache-Control: public, max-age=31536000, immutable
/manifest.json
  Cache-Control: public, max-age=86400

# OG default image
/og-image.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# Per-topic OG images — regenerated on content change, cache 7 days
/v2/og/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Search index — regenerated on content change, cache 1 day
/search.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

# JS/CSS — always serve latest (SW handles offline caching)
/chat-widget.js
  Cache-Control: public, max-age=0, must-revalidate
/index.js
  Cache-Control: public, max-age=0, must-revalidate
/index.css
  Cache-Control: public, max-age=0, must-revalidate
/mobile-nav.js
  Cache-Control: public, max-age=0, must-revalidate
/nav-dropdown.css
  Cache-Control: public, max-age=0, must-revalidate
/chart.js
  Cache-Control: public, max-age=0, must-revalidate
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# v2 sub-pages — short cache with revalidation
/v2/*
  Cache-Control: public, max-age=300, must-revalidate

# HTML pages — always serve latest
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/v2/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Explore page — opt OUT of bfcache. The page runs a long-lived d3
# force simulation + canvas RAF loop; when restored from bfcache, RAF
# and the simulation timer are paused on some browsers (Safari, mobile
# Chrome) and never resume, leaving the map blank/stuck on back-nav.
# `no-store` is the only directive that reliably disqualifies a page
# from bfcache in every browser.
/v2/explore.html
  Cache-Control: no-store
/v2/explore
  Cache-Control: no-store

# Cloudflare Pages Functions — never cache
/api/*
  Cache-Control: no-store

# Static images — long cache (content-addressed via filename when updated)
/*.png
  Cache-Control: public, max-age=2592000
/*.jpg
  Cache-Control: public, max-age=2592000
/*.jpeg
  Cache-Control: public, max-age=2592000
/*.webp
  Cache-Control: public, max-age=2592000
/*.svg
  Cache-Control: public, max-age=2592000
/*.ico
  Cache-Control: public, max-age=2592000

# Fonts (if any are ever self-hosted) — immutable, cache 1 year
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable

# /assets/* — shared design-system CSS/JS, cache 1 day with revalidation
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600
